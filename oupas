<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Record ou Non Record</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap');
    body {
      font-family: 'Roboto', sans-serif;
      margin: 0;
      padding: 40px;
      background-color: #F4F4F4;
      color: #333;
    }
    h1 {
      text-align: center;
      color: #0056A3;
      font-size: 2.5em;
    }
    h2 {
      text-align: left;
      font-weight: normal;
      color: #333;
      margin-top: 10px;
    }
    textarea {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ccc;
      margin: 20px 0;
      font-size: 1em;
    }
    .card {
      background: white;
      padding: 20px;
      margin-top: 30px;
      border-radius: 15px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .question {
      margin: 20px 0 10px;
      font-weight: bold;
      font-style: italic;
      font-size: 1.2em;
    }
    .options button {
      margin: 5px;
      padding: 12px 24px;
      border: none;
      border-radius: 8px;
      background-color: #F5F5F5;
      color: #333;
      cursor: pointer;
      font-weight: bold;
      font-size: 1em;
      transition: background-color 0.3s;
    }
    .options button:hover {
      background-color: #E0E0E0;
    }
    .options button.selected {
      background-color: #0056A3;
      color: white;
    }
    #synthesis {
      display: none;
      margin-top: 40px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      background: white;
      border-radius: 10px;
      overflow: hidden;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: left;
    }
    th {
      background-color: #F1F1F1;
    }
    .green { color: green; font-weight: bold; font-size: 1.2em; }
    .orange { color: orange; font-weight: bold; font-size: 1.2em; }
    .blue { color: #0056A3; font-weight: bold; font-size: 1.2em; }
    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 8px;
      margin-right: 10px;
      margin-top: 20px;
      cursor: pointer;
      font-size: 1em;
    }
    .btn-green {
      background-color: #2ecc71;
      color: white;
    }
    .btn-blue {
      background-color: #0056A3;
      color: white;
    }
  </style>
</head>
<body>

<h1>Record ou Non Record</h1>
<h2>Comment savoir si mon information est un record qui doit être conservé une fois l’activité terminée ?</h2>

<label><strong>Libellé de l'information :</strong></label><br>
<textarea id="infoLabel" rows="2" placeholder="Saisissez votre information..."></textarea>

<div id="questionnaire" class="card">
  <form id="quizForm">
    <div class="question">Question 1 : Sa production est-elle prévue par la loi ou une réglementation, y compris interne ? Une autorité peut-elle nous le demander ?</div>
    <div class="options">
      <button type="button" onclick="selectAnswer(0, 'OUI', this)">OUI</button>
      <button type="button" onclick="selectAnswer(0, 'NON', this)">NON</button>
      <button type="button" onclick="selectAnswer(0, 'JE NE SAIS PAS', this)">JE NE SAIS PAS</button>
    </div>

    <div class="question">Question 2 : Est-elle susceptible d’être utilisée pour défendre nos intérêts en justice ? Vous a-t-elle déjà été demandée par nos juristes ?</div>
    <div class="options">
      <button type="button" onclick="selectAnswer(1, 'OUI', this)">OUI</button>
      <button type="button" onclick="selectAnswer(1, 'NON', this)">NON</button>
      <button type="button" onclick="selectAnswer(1, 'JE NE SAIS PAS', this)">JE NE SAIS PAS</button>
    </div>

    <div class="question">Question 3 : Est-elle indispensable pour de futures activités de l’entité (capitalisation), voire pour prendre des décisions stratégiques à terme ?</div>
    <div class="options">
      <button type="button" onclick="selectAnswer(2, 'OUI', this)">OUI</button>
      <button type="button" onclick="selectAnswer(2, 'NON', this)">NON</button>
      <button type="button" onclick="selectAnswer(2, 'JE NE SAIS PAS', this)">JE NE SAIS PAS</button>
    </div>

    <div class="question">Question 4 : Est-ce que nous aurions des problèmes sérieux voire graves en cas de perte ?</div>
    <div class="options">
      <button type="button" onclick="selectAnswer(3, 'OUI', this)">OUI</button>
      <button type="button" onclick="selectAnswer(3, 'NON', this)">NON</button>
      <button type="button" onclick="selectAnswer(3, 'JE NE SAIS PAS', this)">JE NE SAIS PAS</button>
    </div>

    <button type="button" class="btn btn-green" onclick="showSynthesis()">Afficher la synthèse</button>
  </form>
</div>

<div id="synthesis" class="card"></div>

<script>
  const responses = [null, null, null, null];

  function selectAnswer(questionIndex, value, btn) {
    responses[questionIndex] = value;
    const buttons = btn.parentElement.querySelectorAll('button');
    buttons.forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
  }

  function showSynthesis() {
    if (responses.includes(null)) {
      alert("Merci de répondre à toutes les questions.");
      return;
    }

    const counters = { OUI: 0, NON: 0, "JE NE SAIS PAS": 0 };
    responses.forEach(r => counters[r]++);

    let table = '<table><tr><th>Question</th><th>Réponse</th></tr>';
    responses.forEach((r, i) => {
      table += `<tr><td>Question ${i + 1}</td><td>${r}</td></tr>`;
    });
    table += '</table>';

    let comment = "";
    if (counters["OUI"] >= 1) {
      comment = '<p class="green">C\'est sans doute un record</p>';
    } else if (counters["NON"] === 4) {
      comment = '<p class="orange">Ce n\'est probablement pas un record</p>';
    } else {
      comment = '<p class="blue">Prenez contact avec l\'équipe Records Management records.management@renault.com</p>';
    }

    const pdfBtn = '<button class="btn btn-green" onclick="printPDF()">Imprimer au format PDF</button>';
    const resetBtn = '<button class="btn btn-blue" onclick="location.reload()">Réinitialiser les réponses</button>';

    document.getElementById("synthesis").innerHTML = table + comment + pdfBtn + resetBtn;
    document.getElementById("synthesis").style.display = "block";
  }

  function printPDF() {
    const synth = document.getElementById("synthesis").innerHTML;
    const win = window.open('', '', 'height=600,width=800');
    win.document.write('<html><head><title>Synthèse</title><style>body { font-family: Arial; margin: 40px; } table { width: 100%; border-collapse: collapse; } td, th { border: 1px solid #000; padding: 10px; }</style></head><body>');
    win.document.write(synth);
    win.document.write('</body></html>');
    win.document.close();
    win.print();
  }
</script>

</body>
</html>
